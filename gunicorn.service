
[Unit]
Description=Gunicorn service for FastAPI application
After=network.target

[Service]
User=manu
Group=manu
WorkingDirectory=/home/manu/app/source

EnvironmentFile=/home/manu/.env
Environment="PATH=/home/manu/app/source/venv/bin"

ExecStart=/home/manu/app/source/venv/bin/gunicorn \
    --workers 1 \
    --worker-class uvicorn.workers.UvicornWorker \
    --bind 0.0.0.0:8000 \
    app.main:app

Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
